{
  "name": "animeflow-pro",
  "version": "1.0.0",
  "description": "AnimeFlow Pro \u2014 a premium Bootstrap 5.3 streaming & anime UI kit. Zero jQuery, dark/light themes, RTL, 20 pages, 40+ components.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "clean": "node build.js --clean",
    "build": "node build.js",
    "watch": "node build.js --watch",
    "serve": "node build.js --watch --serve",
    "start": "npm run serve",
    "verify": "node tools/verify.js",
    "interactions": "node tools/interactions.js",
    "test": "npm run build && node tools/verify.js && node tools/interactions.js",
    "shots": "node tools/verify.js --shots"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "esbuild": "^0.25.0",
    "marked": "^15.0.0",
    "playwright": "^1.62.1",
    "rtlcss": "^4.3.0",
    "sass": "^1.102.0"
  }
}
